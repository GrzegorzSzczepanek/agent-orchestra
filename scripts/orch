#!/usr/bin/env bash
# Globalny launcher: orch [KATALOG] [--client auto|claude|opencode|codex|none] [--no-watch] [--simple-watch] [--agents a,b] [-- argumenty klienta]
# Odpala klienta (domyslnie pierwszy znaleziony: claude, opencode, codex) w repo z serwerem orchestra i skillem rozbijania zadan,
# a obok otwiera TUI (orchestra-tui): agenci, strumien, prompt, Ctrl+N nowy agent, F2 diff. Panele w tmux (poza tmux orch sam startuje sesje tmux), bez tmux nowe okno Terminal.app.
# Bez zadnego klienta (--client none albo nic w PATH) startuje samo TUI: przycisk Plan przyjmuje cel (planuje wybrany agent) albo plik planu.
# --simple-watch: tylko podglad zadan run_plan (bez promptow), --agents: sesje startowane od razu (domyslnie pierwszy dostepny z agents.toml).
# Nic nie trzeba rejestrowac globalnie: serwer MCP jest podawany klientowi przy starcie.
set -euo pipefail

SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
BIN="$ROOT/.venv/bin"
SKILL="$ROOT/.agents/skills/orchestrate-hard-task/SKILL.md"
ORIG_ARGS=("$@")
REPO="$PWD"
WATCH=1
SIMPLE=0
AGENTS=""
CLIENT=auto
CLIENT_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-watch) WATCH=0; shift ;;
    --simple-watch) SIMPLE=1; shift ;;
    --agents) AGENTS="${2:?brak wartosci dla --agents}"; shift 2 ;;
    --client) CLIENT="${2:?brak wartosci dla --client}"; shift 2 ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; CLIENT_ARGS=("$@"); break ;;
    -*) echo "Nieznana opcja: $1 (argumenty dla klienta po --)" >&2; exit 2 ;;
    *) REPO="$1"; shift ;;
  esac
done

[[ -x "$BIN/orchestra-mcp" ]] || { echo "Brak .venv w $ROOT. Uruchom: $ROOT/scripts/setup.sh" >&2; exit 1; }
REPO="$(cd "$REPO" && pwd)"
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { echo "To nie jest repozytorium git: $REPO (git init, potem commit)" >&2; exit 1; }
git -C "$REPO" rev-parse HEAD >/dev/null 2>&1 || { echo "Repo nie ma zadnego commita, workery startuja z HEAD." >&2; exit 1; }
if [[ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]]; then
  echo "Uwaga: sa niezacommitowane zmiany. Workery widza tylko HEAD." >&2
fi

CONFIG="$ROOT/agents.toml"
CLIENT="$("$BIN/orchestra-client" --detect --client "$CLIENT" --repo "$REPO" --config "$CONFIG" --skill "$SKILL")" || exit $?
if [[ "$CLIENT" == none ]]; then
  echo "Nie znaleziono klienta (claude, opencode, codex): uruchamiam samo TUI. Przycisk Plan: wpisz cel albo wskaz plik planu." >&2
  exec "$BIN/orchestra-tui" --repo "$REPO" --config "$CONFIG" ${AGENTS:+--agents "$AGENTS"}
fi

# Poza tmux: odpal siebie w nowej sesji tmux (Claude po lewej, TUI po prawej), wszystko w jednym oknie terminala.
if [[ $WATCH -eq 1 && -z "${TMUX:-}" ]] && command -v tmux >/dev/null && [[ -t 0 ]]; then
  SESSION="orch-$(basename "$REPO" | tr -c 'A-Za-z0-9\n' '-')-$$"
  INNER="$(printf '%q ' "$SELF" "${ORIG_ARGS[@]}")"
  tmux new-session -d -s "$SESSION" -c "$REPO" "$INNER; tmux kill-session -t '$SESSION'"
  tmux set-option -t "$SESSION" mouse on >/dev/null
  exec tmux attach -t "$SESSION"
fi

if [[ $WATCH -eq 1 ]]; then
  if [[ $SIMPLE -eq 1 ]]; then
    WATCH_CMD="cd '$REPO' && '$BIN/orchestra' watch --repo '$REPO'"
  else
    WATCH_CMD="cd '$REPO' && '$BIN/orchestra-tui' --repo '$REPO' --config '$CONFIG' ${AGENTS:+--agents '$AGENTS'}"
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux split-window -h -d -l 45% -t "${TMUX_PANE:-}" "$WATCH_CMD"
  elif [[ "$(uname)" == Darwin ]] && command -v osascript >/dev/null; then
    osascript -e "tell application \"Terminal\" to do script \"$WATCH_CMD\"" >/dev/null \
      || echo "Nie udalo sie otworzyc okna. Recznie: $WATCH_CMD" >&2
  else
    echo "Podglad uruchom w drugim terminalu: $WATCH_CMD"
  fi
fi

exec "$BIN/orchestra-client" --client "$CLIENT" --repo "$REPO" --config "$CONFIG" --skill "$SKILL" ${CLIENT_ARGS[@]+"${CLIENT_ARGS[@]}"}
